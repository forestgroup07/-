PORT=3050
# 1 = no MySQL (local Godot smoke). 0 = real MySQL
USE_MEMORY_DB=1
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=sicbo
MYSQL_PASSWORD=sicbo
MYSQL_DATABASE=sicbo_demo
BETTING_SECONDS=20
ROLLING_SECONDS=5
SETTLE_SECONDS=5
DEMO_TOKEN=demo-godot-token
# D4 整局取消口令（运维 / 故障）
CANCEL_TOKEN=sicbo-cancel-token
TABLE_CODE=S601
# D2 桌台限红（与账号 bet_min/bet_max 取交集）
TABLE_BET_MIN=10
TABLE_BET_MAX=5000
ACCOUNT_BET_MIN=10
ACCOUNT_BET_MAX=5000
# D3 彩池：对冲差额限 / 非对冲单项总值限
TABLE_HEDGE_DIFF_MAX=20000
TABLE_POOL_TOTAL_MAX=50000
# D5 演练：模拟贴边概率 0–1（生产保持 0）
SIMULATE_EDGE_RATE=0
